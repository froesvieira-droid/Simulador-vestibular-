rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Results collection
    match /results/{resultId} {
      allow read: if true; // Publicly readable for real-time results leaderboard
      allow create: if isValidResult(request.resource.data);
      allow update, delete: if false; // Results are immutable for simplicity
    }

    function isValidResult(data) {
      return data.userName is string && data.userName.size() > 0 && data.userName.size() <= 100
          && data.score is number && data.score >= 0
          && data.totalQuestions is number && data.totalQuestions > 0
          && data.completedAt is timestamp;
    }
  }
}
